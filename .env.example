# PromptShield Environment Configuration
# Copy this file to .env and configure values for your environment.

# Application Environment
PROJECT_NAME="PromptShield Policy & Database Layer"
ENVIRONMENT="development"
DEBUG=false
API_V1_STR="/api/v1"

# Database Configuration (PostgreSQL primary; supports SQLite fallback for local test runs)
# PostgreSQL production format: postgresql+psycopg://user:password@localhost:5432/promptshield_db
# SQLite fallback format: sqlite:///./promptshield.db
DATABASE_URL="postgresql+psycopg://promptshield_user:promptshield_secure_pass@localhost:5432/promptshield_db"
DATABASE_ECHO=false

# Security & JWT Tokens
# Generate a secure 256-bit key using: openssl rand -hex 32
JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fail-Secure Configuration
# When true, any policy engine failure or missing rule defaults to BLOCK
FAIL_SECURE_MODE=true

# Retention & Redaction
DEFAULT_SECRET_MASK="[REDACTED_SECRET]"
MAX_RETENTION_DAYS=90
