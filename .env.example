# PromptShield - Unified Environment Configuration
# Copy this file to .env and configure values for your environment.

# ==============================================================================
# General Application Environment
# ==============================================================================
PROJECT_NAME="PromptShield"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
API_V1_STR="/api/v1"

# ==============================================================================
# Detection Engine Configuration (Backend)
# ==============================================================================
# Content Processing Limits
MAX_CONTENT_LENGTH=1048576
MAX_SCAN_PAYLOAD_BYTES=2097152

# Policy Service Integration (Laptop 3)
POLICY_SERVICE_URL="http://localhost:8000"
POLICY_TIMEOUT_SECONDS=2.0
POLICY_VERSION="v1.2.0"

# Synthetic Canary Secrets for Integration Testing
# (Non-sensitive test tokens used to verify leakage prevention)
CANARY_TOKENS=["CANARY_VORTEXA_SEC_7749","VRTX-TEST-SECRET-XYZ-99","SYNTHETIC-CANARY-TOKEN-42"]

# ==============================================================================
# Policy & Database Layer Configuration (PromptShield Core)
# ==============================================================================
# Database Configuration (PostgreSQL primary; supports SQLite fallback for local test runs)
# PostgreSQL production format: postgresql+psycopg://user:password@localhost:5432/promptshield_db
# SQLite fallback format: sqlite:///./promptshield.db
DATABASE_URL="postgresql+psycopg://promptshield_user:promptshield_secure_pass@localhost:5432/promptshield_db"
DATABASE_ECHO=false

# Security & JWT Tokens
# Generate a secure 256-bit key using: openssl rand -hex 32
JWT_SECRET_KEY="REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Fail-Secure Configuration
# When true, any policy engine failure or missing rule defaults to BLOCK
FAIL_SECURE_MODE=true

# Retention & Redaction
DEFAULT_SECRET_MASK="[REDACTED_SECRET]"
MAX_RETENTION_DAYS=90

# ==============================================================================
# External LLM Provider Keys (Optional: MockLLMProvider is used if omitted)
# ==============================================================================
GEMINI_API_KEY="your_gemini_api_key_here"
OPENAI_API_KEY="your_openai_api_key_here"
GROQ_API_KEY="your_groq_api_key_here"

