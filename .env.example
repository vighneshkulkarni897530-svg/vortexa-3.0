# PromptShield Detection Engine - Environment Configuration Template
# (Do not place real credentials or production secrets in this file)

ENVIRONMENT=development
LOG_LEVEL=INFO

# Content Processing Limits
MAX_CONTENT_LENGTH=1048576
MAX_SCAN_PAYLOAD_BYTES=2097152

# Laptop 3 Policy Service Integration
POLICY_SERVICE_URL=
POLICY_TIMEOUT_SECONDS=2.0

# Detection Engine Policy Version
POLICY_VERSION=v1.2.0

# Synthetic Canary Secrets for Integration Testing
# (These are non-sensitive test tokens used to verify leakage prevention)
CANARY_TOKENS=["CANARY_VORTEXA_SEC_7749","VRTX-TEST-SECRET-XYZ-99","SYNTHETIC-CANARY-TOKEN-42"]
